# Base de datos PostgreSQL (independiente de helpdesk-app)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kymos_db"

# JWT — usa un secreto largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET="cambia-este-secreto-por-uno-seguro-en-produccion"
JWT_EXPIRES_IN="8h"

# Entorno
NODE_ENV="development"
